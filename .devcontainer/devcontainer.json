{
  "name": "Delvoker Universal Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",        
        "openai.chatgpt",
        "tamasfe.even-better-toml",
        "GitHub.vscode-pull-request-github",
        "eamodio.gitlens"
      ]
    }
  },
  "runArgs": [
    "--net=host"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "mkdir -p /tmp/runtime-1000 && chmod 700 /tmp/runtime-1000"
}